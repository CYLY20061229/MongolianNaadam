.rank-page {
  min-height: 100vh;
  background: #f6f1e8;
  padding-bottom: 40rpx;
  padding-top: 20rpx;
}

.page-actions {
  display: flex;
  justify-content: flex-start;
  margin: 0 24rpx 16rpx;
}

.edit-profile-btn {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(122, 32, 36, 0.1);
  color: rgb(122, 32, 36);
  font-size: 24rpx;
  font-weight: 600;
  border: 2rpx solid rgba(122, 32, 36, 0.14);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #e8e1d8;
  background: #ffffff;
  margin: 0 24rpx 16rpx 24rpx;
  border-radius: 16rpx;
}
.rank-item.me {
  margin-top: 20rpx;
  background: rgba(122, 32, 36, 0.08);

  font-weight: bold;
}

.rank {
  width: 120rpx;
  color: rgb(122, 32, 36);
  font-weight: 600;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 20rpx;
  flex-shrink: 0;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(122, 32, 36, 0.12);
  color: rgb(122, 32, 36);
  font-weight: 600;
}

.name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score {
  font-weight: bold;
  color: rgb(122, 32, 36);
}

.divider {
  text-align: center;
  color: rgb(122, 32, 36);
  font-size: 26rpx;
  margin: 32rpx 0;
  font-weight: 500;
}

.state-card {
  margin: 0 24rpx 20rpx;
  padding: 36rpx 28rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #6c6258;
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(122, 32, 36, 0.04);
}

.state-text {
  font-size: 28rpx;
}

.retry-btn {
  width: 240rpx;
  margin: 24rpx auto 0;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgb(122, 32, 36);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
